# Copy to .env for local runs: `cp .env.example .env`
# Real secrets go to AWS SSM Parameter Store, never here. See docs/ACCESS.md.

# --- Server ---
LISTEN_ADDR=:8080
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
MAX_BODY_BYTES=1048576

# --- Upstream ---
UPSTREAM_URL=https://polygon.drpc.org
UPSTREAM_TIMEOUT=30s

# --- Resilience (transparent defaults) ---
MAX_RETRIES=2
RETRY_BACKOFF=100ms
RATE_LIMIT_RPS=0
CB_ENABLED=false
CB_FAILURE_THRESHOLD=5

# --- Observability (opt-in: empty endpoint => no export / no-op) ---
LOG_LEVEL=info
METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=polygon-rpc-proxy
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SDK_DISABLED=false
# SENTRY_DSN=            # empty => Sentry disabled
